#!/bin/sh
# Starts FC from inside the AppImage.
HERE="$(dirname "$(readlink -f "$0")")"

# The bundled libraries need this glibc or newer; build-appimage.sh reads it from them. On an
# older system (or one without glibc, like Alpine) say so plainly instead of a linker error.
NEED_GLIBC="@NEED_GLIBC@"
have="$(getconf GNU_LIBC_VERSION 2>/dev/null | cut -d' ' -f2)"
[ -n "$have" ] || have="$(ldd --version 2>/dev/null | head -n1 | grep -oE '[0-9]+\.[0-9]+$')"
h_major="${have%%.*}"; h_minor="${have#*.}"; h_minor="${h_minor%%.*}"
n_major="${NEED_GLIBC%%.*}"; n_minor="${NEED_GLIBC#*.}"; n_minor="${n_minor%%.*}"
if [ -z "$have" ] || [ "$h_major" -lt "$n_major" ] || { [ "$h_major" -eq "$n_major" ] && [ "$h_minor" -lt "$n_minor" ]; }; then
    msg="FC needs Linux with glibc $NEED_GLIBC or newer (for example Ubuntu 22.04, Debian 12, Fedora 36, Linux Mint 21 or later). This system has ${have:-no glibc}."
    echo "$msg" >&2
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        zenity --error --title=FC --text="$msg" 2>/dev/null || kdialog --title FC --error "$msg" 2>/dev/null \
            || xmessage "$msg" 2>/dev/null || true
    fi
    exit 1
fi
exec "$HERE/usr/lib/FC/FC" "$@"
